@{
    Layout = null;
    int sanPhamId = ViewBag.SanPhamId;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.table.show.data.css?v=20260625">
    <link rel="stylesheet" href="~/Content/SanPham/UpdateDelete.css?v=20260625">
</head>
<body>
    <div id="biggestContainer">
        <h2>Cập Nhật / Xóa Sản Phẩm (ID: @sanPhamId)</h2>

        <div class="section">
            <h3>Thông Tin Sản Phẩm</h3>
            <input type="hidden" id="sp-id" value="@sanPhamId" />

            <div>
                <label for="sp-name">Tên sản phẩm: <span style="color:red">*</span></label>
                <input class="config-max-width margin-vertical" id="sp-name" required />
            </div>

            <div>
                <label for="sp-short-name">Tên ngắn:</label>
                <input class="config-max-width margin-vertical" id="sp-short-name" />
            </div>

            <div>
                <label for="sp-book-cover-price">Giá bìa: <span style="color:red">*</span></label>
                <input type="number" class="config-max-width margin-vertical" id="sp-book-cover-price" value="0" required />
            </div>

            <div>
                <label for="sp-discount">Chiết khấu (0-100):</label>
                <input type="number" step="1" class="config-max-width margin-vertical" id="sp-discount" placeholder="Để trống hoặc 0 nếu không có" />
            </div>

            <div>
                <label for="sp-sale-price">Giá bán thực tế: <span style="color:red">*</span></label>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <input type="number" class="config-max-width margin-vertical" id="sp-sale-price" value="0" required style="flex: 1;" />
                    <select id="platform-select" style="padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                        <option value="PLAYWITHME" selected>PLAY WITH ME</option>
                        <option value="SHOPEE">SHOPEE</option>
                        <option value="TIKI">TIKI</option>
                        <option value="LAZADA">LAZADA</option>
                    </select>
                    <button type="button" onclick="CalculateSalePriceAuto()" title="Tính giá bán tự động từ mapping, cập nhật giá bìa, chiết khấu nhập hàng nếu cần"
                            style="padding: 8px 16px; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; white-space: nowrap;">
                        🧮 Tính Giá Tự Động
                    </button>
                </div>
                <div id="price-breakdown" style="margin-top: 10px; padding: 10px; background: #f0f7ff; border-left: 4px solid #2196F3; display: none; font-size: 13px;">
                    <!-- Breakdown sẽ hiển thị ở đây -->
                </div>
            </div>

            <div>
                <label for="sp-quantity">Số lượng tồn kho: <span style="color:red">*</span></label>
                <input type="number" class="config-max-width margin-vertical" id="sp-quantity" required />
            </div>

            <div>
                <label for="sp-code">Mã sản phẩm:</label>
                <input class="config-max-width margin-vertical" id="sp-code" />
            </div>

            <div>
                <label for="sp-barcode">Barcode (ISBN):</label>
                <input class="config-max-width margin-vertical" id="sp-barcode" />
            </div>

            <div>
                <label for="combo-id">Combo:</label>
                <input list="list-combo" class="config-max-width margin-vertical" id="combo-id" placeholder="Chọn hoặc nhập tên combo" />
                <datalist id="list-combo"></datalist>
            </div>

            <div>
                <label for="category-id">Category:</label>
                <input list="list-category" class="config-max-width margin-vertical" id="category-id" placeholder="Chọn hoặc nhập tên category" />
                <datalist id="list-category"></datalist>
            </div>

            <div>
                <label for="author-id" title="Cách nhau dấu ',' nếu có nhiều tác giả">Tác giả:</label>
                <input type="text" list="list-author" class="config-max-width margin-vertical" id="author-id">

                <datalist id="list-author"></datalist>
            </div>

            <div>
                <label for="translator-id" title="Cách nhau dấu ',' nếu có nhiều người dịch">Người dịch:</label>
                <input type="text" list="list-translator" class="config-max-width margin-vertical" id="translator-id">

                <datalist id="list-translator"></datalist>
            </div>

            <div>
                <label for="publisher-id">Nhà phát hành:</label>
                <input list="list-Publisher" class="config-max-width margin-vertical" id="publisher-id" placeholder="Chọn hoặc nhập tên nhà xuất bản" />
                <datalist id="list-Publisher"></datalist>
            </div>

            <div>
                <label for="publishing-company-id">Công ty xuất bản:</label>
                <input list="list-publishing-company" class="config-max-width margin-vertical" id="publishing-company-id" placeholder="Chọn hoặc nhập tên công ty xuất bản" />
                <datalist id="list-publishing-company"></datalist>
            </div>

            <div>
                <label for="sp-publishing-time">Năm phát hành:</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-publishing-time" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-product-long">Chiều dài (mm):</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-product-long" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-product-wide">Chiều rộng (mm):</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-product-wide" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-product-high">Chiều cao (mm):</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-product-high" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-product-weight">Trọng lượng (gram):</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-product-weight" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-position-warehouse">Vị trí trong kho:</label>
                <input class="config-max-width margin-vertical" id="sp-position-warehouse" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-hard-cover">Bìa:</label>
                <select class="config-max-width margin-vertical" id="sp-hard-cover">
                    <option value="0">Bìa mềm</option>
                    <option value="1">Bìa cứng</option>
                </select>
            </div>

            <div>
                <label for="sp-min-age">Tuổi nhỏ nhất (tháng):</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-min-age" placeholder="Để trống nếu không giới hạn" />
            </div>

            <div>
                <label for="sp-max-age">Tuổi lớn nhất (tháng):</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-max-age" placeholder="Để trống nếu không giới hạn" />
            </div>

            <div>
                <label for="sp-parent-id">Parent ID:</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-parent-id" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-republish">Tái bản lần thứ:</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-republish" placeholder="Để trống nếu không xác định" />
            </div>

            <div>
                <label for="sp-detail">Chi tiết:</label>
                <textarea spellcheck="false" class="config-max-width margin-vertical" id="sp-detail" rows="25" placeholder="Để trống nếu không có"></textarea>
            </div>

            <div>
                <label for="sp-status">Trạng thái:</label>
                <select class="config-max-width margin-vertical" id="sp-status">
                    <option value="0">Đang kinh doanh</option>
                    <option value="1">Nhà phát hành tạm thời hết hàng</option>
                    <option value="2">Ngừng kinh doanh</option>
                </select>
            </div>

            <div>
                <label for="sp-page-number">Số trang:</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-page-number" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-language">Ngôn ngữ:</label><br>
                <select class="config-max-width margin-vertical" id="sp-language">
                    <option value="Tiếng Việt">Tiếng Việt</option>
                    <option value="Song ngữ">Song ngữ</option>
                    <option value="Tiếng Anh">Tiếng Anh</option>
                    <option value="Đa ngữ">Đa ngữ</option>
                </select>
            </div>

            <div>
                <label for="sp-date">Ngày thêm sản phẩm:</label>
                <input type="date" class="config-max-width margin-vertical" id="sp-date" />
            </div>

            <div>
                <label for="sp-sold-quantity">Số lượng đã bán:</label>
                <input type="number" class="config-max-width margin-vertical" id="sp-sold-quantity" placeholder="Để trống nếu không có" />
            </div>

            <div>
                <label for="sp-url">URL sản phẩm:</label>
                <input class="config-max-width margin-vertical" id="sp-url" />
            </div>

            <div>
                <label for="sp-seo-keyword">SEO Keyword:</label>
                <input class="config-max-width margin-vertical" id="sp-seo-keyword" />
            </div>

            <br />
            <div>
                <button type="button" onclick="UpdateSanPham()">Cập Nhật Sản Phẩm</button>
                <button type="button" onclick="PreviewProduct()" style="margin-left: 20px; background-color: #2196F3;">👁️ Xem Trước</button>
                <button type="button" onclick="DeleteSanPham()" style="margin-left: 100px; background-color: #d9534f;">Xóa Sản Phẩm</button>
            </div>

            <div id="result-message" style="margin-top: 20px; color: green;"></div>
        </div>

        <div class="section">
            <h3>📦 Mapping Sản Phẩm Kho</h3>
            <p style="color: #666; font-size: 14px;">Map sản phẩm bán này với các sản phẩm thực tế trong kho (tbproducts)</p>

            <div class="mapping-add-section" style="margin-bottom: 20px; padding: 15px; background: #f9f9f9; border-radius: 5px;">
                <h4 style="margin-top: 0;">Chọn Sản Phẩm Kho Để Mapping</h4>

                <!-- Filters -->
                <div style="display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; align-items: center;">

                    <div>
                        <input list="list-product-name" class="config-max-width margin-vertical" id="product-name-id" placeholder="Chọn hoặc nhập tên">
                        <datalist id="list-product-name">
                        </datalist>
                    </div>

                    <div>
                        <input list="list-combo-2" class="config-max-width margin-vertical" id="combo-id-2" placeholder="Chọn hoặc nhập tên combo" />
                        <datalist id="list-combo-2"></datalist>
                    </div>

                    <button type="button" onclick="SearchTbProductsForMapping()"
                            style="padding: 8px 16px; background: #5cb85c; color: white; border: none; border-radius: 4px; cursor: pointer;">
                        🔍 Tìm Kiếm
                    </button>
                </div>

                <!-- Selection Actions -->
                <div style="display: flex; gap: 10px; margin-bottom: 10px; align-items: center;">
                    <button type="button" onclick="AddSelectedKhoMapping()"
                            style="padding: 8px 20px; background: #5cb85c; color: white; border: none; border-radius: 4px; cursor: pointer;">
                        + Thêm Đã Chọn (<span id="selected-count">0</span>)
                    </button>
                    <label style="font-size: 14px; color: #666;">
                        <input type="checkbox" id="select-all-checkbox" onchange="ToggleSelectAll()" />
                        Chọn tất cả
                    </label>
                    <span style="margin-left: auto; font-size: 14px; color: #666;">
                        Tổng: <span id="tbproducts-total">0</span> sản phẩm
                    </span>
                </div>

                <!-- Table sản phẩm kho -->
                <div style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; border-radius: 4px;">
                    <table id="tbproducts-table" style="width: 100%; border-collapse: collapse; background: white;">
                        <thead style="position: sticky; top: 0; background: #f5f5f5; z-index: 1;">
                            <tr>
                                <th style="padding: 8px; border: 1px solid #ddd; width: 40px; text-align: center;">☑</th>
                                <th style="padding: 8px; border: 1px solid #ddd; width: 50px;">STT</th>
                                <th style="padding: 8px; border: 1px solid #ddd; width: 60px;">Ảnh</th>
                                <th style="padding: 8px; border: 1px solid #ddd; width: 100px;">Mã</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Tên</th>
                                <th style="padding: 8px; border: 1px solid #ddd; width: 80px;">Số lượng</th>
                            </tr>
                        </thead>
                        <tbody id="tbproducts-tbody">
                            <tr>
                                <td colspan="6" style="padding: 20px; text-align: center; color: #999;">
                                    Đang đợi dữ liệu...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mapping-list-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <h4 style="margin: 0;">Danh Sách Đã Map (<span id="mapping-count">0</span>)</h4>
                    <div style="display: flex; gap: 10px;">
                        <button type="button" onclick="CopyToNewProduct()"
                                title="Tạo sản phẩm mới từ sản phẩm hiện tại (không copy giá tiền, media, mapping, code, barcode)"
                                style="padding: 8px 16px; background: #FF9800; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;">
                            ➕ Tạo Sản Phẩm Mới
                        </button>
                        <button type="button" id="copy-data-btn" onclick="CopyDataFromKhoProduct()" disabled
                                title="Chép dữ liệu từ sản phẩm kho sang sản phẩm bán"
                                style="padding: 8px 16px; background: #2196F3; color: white; border: none; border-radius: 4px; cursor: pointer; transition: opacity 0.3s;">
                            📋 Chép Dữ Liệu
                        </button>
                        <button type="button" id="copy-images-btn" onclick="CopyImagesFromKhoProduct()" disabled
                                title="Chép toàn bộ ảnh từ sản phẩm kho sang sản phẩm bán (xóa ảnh cũ và sinh phiên bản 320), không chép video"
                                style="padding: 8px 16px; background: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; transition: opacity 0.3s;">
                            🖼️ Chép Ảnh
                        </button>
                    </div>
                </div>
                <div style="overflow-x: auto;">
                    <table id="mapping-table" style="width: 100%; border-collapse: collapse; background: white;">
                        <thead>
                            <tr style="background: #f5f5f5;">
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: left; width: 50px;">STT</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 80px;">Ảnh</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: left; width: 120px;">Mã Kho</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Tên Sản Phẩm Kho</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: right; width: 100px;">Giá Bìa</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 80px;">Chiết Khấu</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 100px;">SL Kho</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 100px;">SL Cần</th>
                                <th style="padding: 10px; border: 1px solid #ddd; text-align: center; width: 80px;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody id="mapping-tbody">
                            <tr>
                                <td colspan="9" style="padding: 20px; text-align: center; color: #999;">
                                    Chưa có mapping nào. Thêm sản phẩm kho ở phía trên.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="section">
            <h3>Quản Lý Media (Ảnh / Video)</h3>

            <div class="upload-section">
                <h4>Upload Media Mới</h4>
                <p><strong>Lưu ý:</strong> Cần cập nhật lại thứ tự sau khi upload.video là 0, ảnh là 1,2,3... Không video thì thứ tự ảnh là 0,1,2....</p>
                <input type="file" id="file-upload" multiple accept="image/*,video/*" />
                <button type="button" onclick="UploadFiles()" style="margin-top: 10px;">Upload</button>
            </div>

            <div style="margin: 20px 0; padding: 15px; background: #fff3e0; border-left: 4px solid #FF9800; border-radius: 4px;">
                <h4 style="margin-top: 0; color: #FF9800;">🎨 Copy Ảnh Bìa Từ Sản Phẩm Lẻ Cùng Combo</h4>
                <p style="margin: 8px 0; color: #666;">
                    <strong>Điều kiện:</strong> Sản phẩm có tên ngắn chứa "Combo" VÀ có ComboId.<br>
                    <strong>Chức năng:</strong> Tự động copy ảnh bìa (có DisplayOrder nhỏ nhất) từ các sản phẩm lẻ cùng combo vào sản phẩm combo này.
                </p>
                <button type="button"
                        onclick="CopyCoversFromComboProducts()"
                        style="background: #FF9800; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 14px;">
                    🎨 Copy Ảnh Bìa Từ Sản Phẩm Lẻ
                </button>
            </div>

            <div style="margin: 20px 0; padding: 15px; background: #f0f7ff; border-left: 4px solid #2196F3; border-radius: 4px;">
                <h4 style="margin-top: 0; color: #2196F3;">🤖 Claude AI - Tạo Alt Text & Auto Đổi Tên</h4>
                <p style="margin: 8px 0; color: #666;">
                    <strong>Bước 1:</strong> Tạo Title, Alt Text, Description cho tất cả ảnh bằng Claude AI.<br>
                    <strong>Bước 2:</strong> Auto đổi tên file dựa trên thông tin AI trả về hoặc trang trong Alt Text (VD: "trang 2-3" → "trang-2-3").
                </p>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button type="button"
                            onclick="GenerateAltTextForAllImages()"
                            style="background: #2196F3; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 14px;">
                        🤖 Lấy Alt Text Tất Cả Ảnh
                    </button>
                    <button type="button"
                            onclick="AutoRenameAllImagesFromAltText()"
                            style="background: #9C27B0; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 14px;">
                        🤖 Auto Đổi Tên Tất Cả Ảnh
                    </button>
                </div>
            </div>

            <div id="media-container" class="media-container">
                <!-- Media items will be loaded here -->
            </div>
        </div>
    </div>

    <script src="~/Scripts/web.play.with.me.update.width.js?v=20260625"></script>
    <script src="~/Scripts/web.play.with.me.common.js?v=20260625"></script>
    <script>
        const sanPhamId = '@sanPhamId';
    </script>
    <script src="~/Scripts/SanPham/UpdateDelete.js?v=20260625"></script>
</body>
</html>
