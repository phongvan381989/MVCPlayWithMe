@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.table.show.data.css?v=20260625">
    <link rel="stylesheet" href="~/Content/SanPham/Search.css?v=20260625">
</head>
<body>

    <div id="biggestContainer">
        <h2>Danh Sách Sản Phẩm</h2>

        <div class="search-section">
            <div class="filter-row">
                <input type="text" id="search-keyword" placeholder="Tìm theo tên, mã, barcode..." />
                <input list="list-combo" id="combo-id" placeholder="Chọn combo..." />
                <datalist id="list-combo"></datalist>
                <input list="list-category" id="category-id" placeholder="Chọn category..." />
                <datalist id="list-category"></datalist>
                <input list="list-Publisher" id="publisher-id" placeholder="Chọn nhà phát hành..." />
                <datalist id="list-Publisher"></datalist>
                <select id="filter-status">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="0">Đang kinh doanh</option>
                    <option value="1">Nhà phát hành hết hàng</option>
                    <option value="2">Ngừng kinh doanh</option>
                </select>
            </div>
            <div class="filter-row">
                <button onclick="RenderSanPhamList()">🔍 Tìm Kiếm</button>
                <button onclick="ClearFilters()" style="background: #FF9800;">🔄 Làm Mới</button>
            </div>
        </div>

        <div class="action-buttons">
            <button onclick="window.location.href='/SanPham/Create'">+ Thêm Sản Phẩm Mới</button>
        </div>

        <div class="table-container">
            <table id="sanpham-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên Sản Phẩm</th>
                        <th>Tên Ngắn</th>
                        <th>Giá Bìa</th>
                        <th>Chiết Khấu (%)</th>
                        <th>Tồn Kho</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="sanpham-tbody">
                    <tr>
                        <td colspan="8" class="no-data">Đang tải dữ liệu...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div id="result-message" style="margin-top: 20px; color: green;"></div>
    </div>

    <script src="~/Scripts/web.play.with.me.update.width.js?v=20260625"></script>
    <script src="~/Scripts/web.play.with.me.common.js?v=20260625"></script>
    <script src="~/Scripts/SanPham/Search.js?v=20260625"></script>
</body>
</html>
