@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.table.show.data.css?v=20261029">
    <link rel="stylesheet" href="~/Content/EInvoice/Check.css">
</head>
<body>
    <div id="biggestContainer">
        <div class="config-max-width padding-container">
            <h2>Kiểm Tra Hóa Đơn Cần Sửa Đổi</h2>
            <p style="color: #6c757d; margin-bottom: 20px;">
                Danh sách đơn hàng có sự kiện hoàn hàng, hoàn một phần cần kiểm tra và sửa đổi hóa đơn
            </p>

            <div class="filter-buttons">
                <label>Lọc theo trạng thái:</label>
                <button type="button" class="active" onclick="FilterByStatus(0)">Cần Check</button>
                <button type="button" onclick="FilterByStatus(null)">Tất Cả</button>
                <button type="button" onclick="LoadData()" style="margin-left: auto; background-color: #007bff; color: white;">
                    🔄 Tải Lại
                </button>
            </div>

            <div class="count-result" id="count-result"></div>

            <table id="myTableCheckInvoice">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Sàn TMĐT</th>
                        <th>Mã Đơn</th>
                        <th>Thời Gian</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>

    <script src="~/Scripts/web.play.with.me.common.js?v=20261029"></script>
    <script src="~/Scripts/EInvoice/Check.js?v=20261029"></script>
</body>
</html>
