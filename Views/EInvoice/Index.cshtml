@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.table.show.data.css?v=20261024">
    <link rel="stylesheet" href="~/Content/EInvoice/Index.css">
</head>
<body>
    <div id="biggestContainer">
        <h2>Quản Lý Hóa Đơn Điện Tử</h2>

        <div class="display-flex-margin10">
            <label for="filter-date" class="vndejhx90">Từ ngày:</label>
            <input type="date" id="filter-date" class="vndejhx90" />

            <button type="button" class="vndejhx90" onclick="LoadInvoiceList()"
                    title="Tải danh sách hóa đơn">
                Tải Danh Sách
            </button>

            <div style="margin-left: 20px;">
                <label style="margin-right: 10px;">
                    <input type="radio" name="filter-need-invoice" value="all" onchange="DisplayInvoiceTable()" />
                    Tất Cả
                </label>
                <label style="margin-right: 10px;">
                    <input type="radio" name="filter-need-invoice" value="need" checked onchange="DisplayInvoiceTable()" />
                    Cần HĐ
                </label>
                <label>
                    <input type="radio" name="filter-need-invoice" value="pending" onchange="DisplayInvoiceTable()" />
                    Chưa Xuất HĐ
                </label>
            </div>

            <label id="count-invoice" style="padding-left:20px;">0 hóa đơn</label>
        </div>

        <div>
            <table class="invoice-table" id="invoice-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Sàn</th>
                        <th>Mã Đơn</th>
                        <th>Trạng Thái Đơn</th>
                        <th>TG Cần Xuất HD</th>
                        <th>Cần HĐ</th>
                        <th>Trạng Thái HĐ</th>
                        <th>Ngày Xuất</th>
                        <th>Mã HĐ</th>
                        <th>Mã Tra Cứu</th>
                        <th>Invoice ID</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>

    <script src="~/Scripts/web.play.with.me.common.js?v=20261024"></script>
    <script src="~/Scripts/EInvoice/Index.js?v=20261024"></script>
</body>
</html>
