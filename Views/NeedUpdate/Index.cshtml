
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.table.show.data.css?v=20261019">
    <link rel="stylesheet" href="~/Content/NeedUpdate/Index.css?v=20261019">
</head>
<body>
    <div id="biggestContainer">
        <h1>🔄 Cập Nhật Giá & Tồn Kho Lên Sàn</h1>
        <p class="page-description">
            Quản lý đồng bộ thông tin giá và tồn kho sản phẩm lên các sàn thương mại điện tử
        </p>

        <!-- Chọn sàn TMĐT -->
        <div class="section">
            <div class="section-title">Chọn Sàn Thương Mại Điện Tử</div>
            @Html.Partial("~/Views/Shared/ECommerceType.cshtml")
        </div>

        <!-- Cập nhật giá -->
        <div class="section">
            <div class="section-title">💰 Cập Nhật Giá Sản Phẩm</div>
            <div class="button-group">
                <button type="button" class="action-button btn-update-changed-price" onclick="UpdateChangedPrice()">
                    <span>📊</span>
                    <span>Cập Nhật Giá Có Thay Đổi</span>
                </button>
                <button type="button" class="action-button btn-update-all-price" onclick="UpdateAllPrice()">
                    <span>🔄</span>
                    <span>Cập Nhật Giá Toàn Bộ</span>
                </button>
            </div>
        </div>

        <!-- Cập nhật tồn kho -->
        <div class="section">
            <div class="section-title">📦 Cập Nhật Tồn Kho</div>
            <div class="button-group">
                <button type="button" class="action-button btn-update-changed-stock" onclick="UpdateChangedStock()">
                    <span>📈</span>
                    <span>Cập Nhật Tồn Kho Có Thay Đổi</span>
                </button>
                <button type="button" class="action-button btn-update-all-stock" onclick="UpdateAllStock()">
                    <span>♻️</span>
                    <span>Cập Nhật Tồn Kho Toàn Bộ</span>
                </button>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.3.1.min.js"></script>
    <script src="~/Scripts/web.play.with.me.common.js"></script>
    <script src="~/Scripts/NeedUpdate/Index.js?v=20261019"></script>
</body>
</html>
