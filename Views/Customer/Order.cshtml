@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/Customer/Order.css?v=20260610">
</head>
<body>

    <div id="biggestContainer">
        @Html.Partial("~/Views/Shared/biggestContainer_Top.cshtml")
        <div>
            <div class="search-filter-order">
                <div class="order-search-container">
                    <div>
                        <img class="icon20" src="~/Media/searchIcon.png">
                    </div>
                    <input class="order-search-input-text" id="search-input-text-order-id" type="text" value="">
                    <button type="button" class="search-button" onclick="OrderSearch()">Tìm kiếm</button>
                </div>
                <div class="filter-container">
                    <button type="button" class="nvsflAB87" onclick="FilterOrderAll(this);">Tất cả</button>
                    <button type="button" class="nvsflAB87" onclick="FilterOrderPending(this);">Chờ thanh toán</button>
                    <button type="button" class="nvsflAB87" onclick="FilterOrderProcessing(this);">Chuẩn bị hàng</button>
                    <button type="button" class="nvsflAB87" onclick="FilterOrderShipping(this);">Đang giao</button>
                    <button type="button" class="nvsflAB87" onclick="FilterOrderReceived(this);">Đã nhận</button>
                    <button type="button" class="nvsflAB87" onclick="FilterOrderCancelled(this);">Đã hủy</button>
                    <button type="button" class="nvsflAB87" onclick="FilterOrderRefunded(this);">Hoàn tiền</button>
                </div>
            </div>
            <div class="sample-item-container">
                <img class="model-icon"
                     src="/Media/NoImageThumbnail.png"
                     onerror="this.onerror=null; this.src='/Media/NoImageThumbnail.png';"
                     alt="No image"
                     loading="lazy" />
                <div class="name-quantity">
                    <div class="ffZM87hf-name">Tên sản phẩm</div>
                    <div class="G7E4B7">
                        <span class="vWt6ZL">₫39.000</span>
                        <span class="M-AAFK">₫29.800</span>
                        <span class="quantity-model-x">x</span>
                        <span class="quantity-model">1</span>
                    </div>
                </div>
            </div>
            <div class="sample-payment">
                <div class="money-title">Tổng tiền hàng</div>
                <div class="money-padding">₫156,000</div>
            </div>
            <div class="sample-order">
                <div class="order-header">
                    <div class="order-code"></div>
                    <span class="yMGIuJ">|</span>
                    <div class="fxASnxvd">Hoàn Thành</div>
                </div>
                <div class="sample-address-container">
                    <div class="address-date">09/24/2024</div>
                    <div class="address-name-phone">Huệ hoàng (+84) 383519872</div>
                    <div class="address-address">Số 28, Ngõ 3, Khu Tập Thể Đo Lường, Tổ Dân Phố 3A, phường Đông Ngạc, Hà Nội</div>
                </div>
                <div class="order-item-container">

                </div>
                <div class="message-to-shop">
                    <div class="gQuJxM">Lời nhắn</div>
                </div>
                <div class="payment-method">
                    <div class="SzEjHI">Phương thức thanh toán</div>
                    <div class="mvna89xnd">
                        <div class="hjhgui88">
                            <span class="KoRB7y payment-method-text">Thanh toán khi nhận hàng</span>
                        </div>
                    </div>
                </div>
                <div class="payment-infor">
                    <div class="checkout-money-flex-end ">
                        <div class="money-title">Tổng tiền hàng</div>
                        <div class="money-padding model-money-sum">₫0</div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Phí vận chuyển</div>
                        <div class="money-padding shipee-fee">₫0</div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Giảm giá phí vận chuyển</div>
                        <div class="money-padding free-shipee-fee">₫0</div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Giảm giá tổng tiền hàng</div>
                        <div class="money-padding discount-final-money">₫0</div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Tổng thanh toán</div>
                        <div class="money-padding final-money">₫0</div>
                    </div>
                </div>
            </div>

            <div class="result-container">
                <div class="result-content-container">
                    <div class="empty-order-state">Danh sách trống</div>
                </div>
            </div>
        </div>
        @Html.Partial("~/Views/Shared/biggestContainer_Bottom.cshtml")
    </div>

    <script src="~/Scripts/web.play.with.me.common.js?v=20260610"></script>
    <script src="~/Scripts/cart-manager.js"></script>
    <script src="~/Scripts/web.play.with.me.action.common.js?v=20260610"></script>
    <script src="~/Scripts/Customer/CommonOrder.js?v=20260610"></script>
    <script src="~/Scripts/Customer/Order.js?v=20260610"></script>
</body>
</html>
