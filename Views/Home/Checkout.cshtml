
@{
    Layout = null;
    var bankAccount = ViewBag.BankAccount as MVCPlayWithMe.Models.BankAccount.BankAccount;
    var orderDeadline = ViewBag.OrderDeadline ?? 48; // Default 48 giờ nếu không có
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.modal.common.css?v=20260610">
    <link rel="stylesheet" href="~/Content/Home/Checkout.css?v=20260610">
</head>
<body>
    <div id="biggestContainer">
        @Html.Partial("~/Views/Shared/biggestContainer_Top.cshtml")
        <div class="sample-model">
            <div class="model-wrapper">
                <div class="EOqcX3">
                    <img class="rTOisL" alt="product image" src="https://down-vn.img.susercontent.com/file/vn-11134207-7qukw-liwhf99gb1n039_tn">
                    <div>
                        <div>
                            <span class="item-name">
                                Gạo Thơm RVT Vinaseed Túi 5kg - Nhà phân phối chính hãng - Giá Sỉ, Date mới
                            </span>
                        </div>
                        <div class="G7E4B7">
                            <span class="vWt6ZL">₫39.000</span>
                            <span class="M-AAFK ">₫29.800</span>
                            <span class="quantity-model-x">x</span>
                            <span class="quantity-model">1</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="cart-empty">
            <strong>Bạn chưa chọn sản phẩm nào.</strong>
            <p>Quay về <a href="/" title="">trang chọn sản phẩm</a></p>
        </div>
        <div class="main-container">
            <div class="address-model">
                <div class="address-container">
                    <div class="letter-boder"></div>
                    <div class="address-detail">
                        <div class="address-icon">
                            <div class="Iafoll">
                                <svg height="16" viewBox="0 0 12 16" width="12" class="icon-location-marker">
                                    <path d="M6 3.2c1.506 0 2.727 1.195 2.727 2.667 0 1.473-1.22 2.666-2.727 2.666S3.273 7.34 3.273 5.867C3.273 4.395 4.493 3.2 6 3.2zM0 6c0-3.315 2.686-6 6-6s6 2.685 6 6c0 2.498-1.964 5.742-6 9.933C1.613 11.743 0 8.498 0 6z" fill-rule="evenodd"></path>
                                </svg>
                            </div>
                            <h2>Địa chỉ nhận hàng</h2>
                        </div>
                        <div class="address-content">
                            <div class="address-name-phone">Tên (+84) SDT</div>
                            <div class="address-address">địa chỉ</div>
                            <div class="address-default">Mặc định</div>
                            <button type="button" class="change-address-btn">Thay đổi</button>
                        </div>
                    </div>
                </div>
                <div class="selected_model">
                    <div class="model-container">

                    </div>
                </div>
                <div class="message-to-shop">
                    <textarea class="gQuJxM" placeholder="Lời nhắn cho Shop" rows="2"></textarea>
                </div>
            </div>
            <div class="payment-method">
                <div class="SzEjHI">Phương thức thanh toán</div>
                <div class="mvna89xnd">
                    <div class="hjhgui88">
                        <input type="radio" name="payment-method" id="payment-cod" value="cod" checked>
                        <label for="payment-cod" class="KoRB7y">Thanh toán khi nhận hàng</label>
                    </div>
                    <div class="hjhgui88 jh-bank-transfer">
                        <input type="radio" name="payment-method" id="payment-bank" value="bank">
                        <label for="payment-bank" class="KoRB7y">Chuyển khoản ngân hàng</label>
                        <div class="bank-transfer-container" style="display: none; margin-top: 15px; padding: 15px; background: #f8f9fa; border-radius: 6px;">
                            @if (bankAccount != null)
                            {
                                <div style="margin-bottom: 10px;">
                                    <div style="color: #6c757d; font-size: 0.9rem; margin-bottom: 8px;">
                                        <i class="fas fa-info-circle"></i> Thông tin chuyển khoản
                                    </div>
                                    <div style="background: white; padding: 12px; border-radius: 4px; margin-bottom: 8px;">
                                        <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #e9ecef;">
                                            <span style="color: #6c757d; font-size: 0.85rem;">Ngân hàng:</span>
                                            <span style="font-weight: 500; font-size: 0.9rem;">@bankAccount.BankName</span>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #e9ecef;">
                                            <span style="color: #6c757d; font-size: 0.85rem;">Số TK:</span>
                                            <span style="font-weight: 600; font-size: 0.9rem;">@bankAccount.AccountNumber</span>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; padding: 6px 0;">
                                            <span style="color: #6c757d; font-size: 0.85rem;">Chủ TK:</span>
                                            <span style="font-weight: 500; font-size: 0.9rem;">@bankAccount.AccountHolder</span>
                                        </div>
                                    </div>
                                    <div style="background: #fff3cd; border: 1px solid #ffc107; padding: 10px; border-radius: 4px; font-size: 0.85rem; color: #856404;">
                                        <strong>📌 Lưu ý:</strong> Mã QR thanh toán và mã đơn hàng sẽ hiển thị sau khi bạn nhấn "Đặt hàng"
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div style="color: #dc3545; font-size: 0.9rem;">
                                    Không tìm thấy thông tin tài khoản ngân hàng. Vui lòng liên hệ shop.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="payment-infor">
                <div class="checkout-money-flex-end">
                    <div class="money-title">Tổng tiền hàng</div>
                    <div class="money-padding model-money-sum">₫405.080</div>
                </div>
                <div class="checkout-money-flex-end">
                    <div class="money-title">Phí vận chuyển</div>
                    <div class="money-padding shipee-fee">₫39.150</div>
                </div>
                <div class="checkout-money-flex-end">
                    <div class="money-title">Giảm giá phí vận chuyển</div>
                    <div class="money-padding free-shipee-fee">-₫39.150</div>
                </div>
                <div class="checkout-money-flex-end">
                    <div class="money-title">Giảm giá tổng tiền hàng</div>
                    <div class="money-padding discount-final-money">-₫39.150</div>
                </div>
                <div class="checkout-money-flex-end">
                    <div class="money-title">Tổng thanh toán</div>
                    <div class="money-padding final-money">₫0</div>
                </div>
                <div class="checkout-money-flex-end">
                    <button type="button" class="order-btn" onclick="CheckOutOrder()">Đặt hàng</button>
                </div>
            </div>
        </div>
        @Html.Partial("~/Views/Shared/Home/CustomerInfor.cshtml")
        @Html.Partial("~/Views/Shared/Home/ListCustomerInfor.cshtml")
        @*@Html.Partial("~/Views/Shared/biggestContainer_Bottom.cshtml")*@
    </div>
    <script src="~/Scripts/web.play.with.me.update.width.js?v=20260610"></script>
    <script src="~/Scripts/web.play.with.me.common.js?v=20260610"></script>
    <script src="~/Scripts/web.play.with.me.customer.infor.cookie.js?v=20260610"></script>
    <script src="~/Scripts/web.play.with.me.address.js?v=20260610"></script>
    <script src="~/Scripts/cart-manager.js"></script>
    <script src="~/Scripts/web.play.with.me.action.common.js?v=20260610"></script>
    <script src="~/Scripts/Customer/CommonOrder.js?v=20260610"></script>
    <script>
        // Pass orderDeadline từ C# sang JavaScript
        const ORDER_DEADLINE_HOURS = @orderDeadline;
    </script>
    <script src="~/Scripts/Home/Checkout.js?v=20260610"></script>
</body>
</html>
