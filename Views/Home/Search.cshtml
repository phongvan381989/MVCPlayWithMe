@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/Home/Search.css?v=20260610">
</head>
<body>
    <div id="biggestContainer">
        @Html.Partial("~/Views/Shared/biggestContainer_Top.cshtml")

        <div class="free-instant-ship">
            <div class="free-instant-ship-message">🚚 Miễn phí vận chuyển đơn 200K+</div>
            <span class="separator">|</span>
            <div class="free-instant-ship-message">⚡ Giao nhanh 2h nội thành</div>
        </div>
        <div id="empty-result" style="display:none">
            <p>Kết quả trống</p>
        </div>
        <div id="search-result" style="display:none">
            <div class="product-for-selector-sample">
                <a class="product-item" href="#">
                    <div class="image-wrapper">
                        <img class="card-img-top" alt="Card image">
                    </div>
                    <div class="product-infor">
                        <div class="product-name">
                            <h3 class="product-name-h3"></h3>
                        </div>
                        @*<div class="rating-quantity-sold">
                            <p class="rating-quantity-sold-p" style="color:black; font-size:x-small"></p>
                        </div>*@
                        <div class="price-sell-original-discount-percent">
                            <span class="price-sell-detail">
                            </span>
                            <span class="price-original-detail"></span>
                            <span class="price-discount-percent-detail"> %</span>
                        </div>
                    </div>
                </a>
            </div>
            <div id="biggestContainer_body_wraper_item">
            </div>

            @* Load More section - thay thế numbered pagination *@
            <div id="load-more-section" style="display:none; padding:1rem; text-align:center;">
                <button id="btnLoadMore" class="pwm-btn-common" style="display:none;">
                    <span id="btn-text">Xem thêm sản phẩm</span>
                </button>
                <p id="end-message" style="display:none; color:#999; font-size:14px;">
                    🎉 Đã xem hết tất cả sản phẩm
                </p>
            </div>
        </div>

        @Html.Partial("~/Views/Shared/biggestContainer_Bottom.cshtml")
    </div>
    <script src="~/Scripts/web.play.with.me.common.js?v=20260823"></script>
    <script src="~/Scripts/cart-manager.js"></script>
    <script src="~/Scripts/web.play.with.me.action.common.js?v=20260823"></script>
    <script src="~/Scripts/Home/Search.js?v=20260823_loadmore"></script>
</body>
</html>
