@using MVCPlayWithMe.Models.SanPhamModel
@using MVCPlayWithMe.General
@{
    Layout = null;
    var initialProducts = ViewBag.InitialProducts as List<SanPhamBasicInfo> ?? new List<SanPhamBasicInfo>();
    var hasMore = ViewBag.HasMore ?? false;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var keyword = Request.QueryString["keyword"] ?? "";

    // ✅ H1 title (giống logic trong Search.js)
    var h1Title = string.IsNullOrWhiteSpace(keyword)
        ? Common.titleVoiBeNho
        : $"Kết quả tìm kiếm: \"{keyword.Trim()}\"";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>@ViewData["title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0">

    @{
        // SEO: Chỉ noindex search results, KHÔNG noindex trang chủ
        bool isSearchPage = Request.QueryString["keyword"] != null ||
                            Request.QueryString["author"] != null ||
                            Request.QueryString["translator"] != null ||
                            Request.QueryString["category"] != null ||
                            Request.QueryString["publishingCompany"] != null ||
                            Request.QueryString["publisher"] != null ||
                            Request.QueryString["page"] != null;

        // Meta content cho trang chủ
        string metaTitle = string.IsNullOrWhiteSpace(keyword)
            ? "Tiệm sách Voi bé nhỏ - Sách & Đồ chơi"
            : $"Kết quả tìm kiếm: \"{keyword.Trim()}\" - Tiệm sách Voi bé nhỏ";

        string metaDescription = string.IsNullOrWhiteSpace(keyword)
            ? "Tiệm sách Voi bé nhỏ - Chuyên cung cấp sách & đồ chơi thiếu nhi chất lượng. Miễn phí vận chuyển đơn 200K+, hỏa tốc nội thành Hà Nội. Giao hàng toàn quốc."
            : $"Tìm kiếm sách \"{keyword.Trim()}\" tại Tiệm sách Voi bé nhỏ.";

        string ogImage = "https://voibenho.com/Media/800_800LOGO.png";
        string ogUrl = "https://voibenho.com" + Request.Url.PathAndQuery;
    }

    @if (isSearchPage)
    {
        <meta name="robots" content="noindex, follow">
    }

    <!-- SEO Meta Tags -->
    <meta name="description" content="@metaDescription">
    <meta name="keywords" content="tiệm sách, sách thiếu nhi, sách văn học, sách kỹ năng sống, mua sách online, voi bé nhỏ, voibenho">
    <link rel="canonical" href="@ogUrl">

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="@metaTitle">
    <meta property="og:description" content="@metaDescription">
    <meta property="og:image" content="@ogImage">
    <meta property="og:image:width" content="800">
    <meta property="og:image:height" content="800">
    <meta property="og:image:alt" content="Logo Tiệm sách Voi bé nhỏ">
    <meta property="og:url" content="@ogUrl">
    <meta property="og:site_name" content="Tiệm sách Voi bé nhỏ">
    <meta property="og:locale" content="vi_VN">
    <meta property="fb:pages" content="@Common.idFacebookPageTiemSachVBN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@metaTitle">
    <meta name="twitter:description" content="@metaDescription">
    <meta name="twitter:image" content="@ogImage">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/Media/favico_centered_elephent.png">
    <link rel="apple-touch-icon" href="~/Media/800_800LOGO.png">

    @Styles.Render("~/bundles/css/common")
    @Styles.Render("~/bundles/css/search")

    @if (!Context.IsDebuggingEnabled)
    {
        @Html.Partial("~/Views/Shared/_GoogleAnalytics.cshtml")
        @Html.Partial("~/Views/Shared/_MetaPixel.cshtml")
    }

    @if (!isSearchPage)
    {
        <!-- Structured Data (JSON-LD) cho Google - Chỉ trang chủ -->
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "Organization",
            "name": "Tiệm sách Voi bé nhỏ",
            "alternateName": "voibenho.com",
            "url": "https://voibenho.com",
            "logo": "https://voibenho.com/Media/800_800LOGO.png",
            "description": "Tiệm sách Voi bé nhỏ - Chuyên cung cấp sách thiếu nhi, văn học, kỹ năng sống chất lượng. Miễn phí vận chuyển đơn 200K+, hỏa tốc nội thành Hà Nội.",
            "sameAs": [
                "https://www.facebook.com/voibenho"
            ],
            "contactPoint": {
                "@@type": "ContactPoint",
                "contactType": "Customer Service",
                "areaServed": "VN",
                "availableLanguage": "Vietnamese"
            },
            "address": {
                "@@type": "PostalAddress",
                "addressCountry": "VN",
                "addressLocality": "Hà Nội"
            }
        }
        </script>
    }

</head>
<body>
    <div id="biggestContainer">
        @Html.Partial("~/Views/Shared/biggestContainer_Top.cshtml")

        <a href="/Policy/TransportPolicy" class="free-instant-ship-link">
            <div class="free-instant-ship">
                <div class="free-instant-ship-message">🚚 Miễn phí vận chuyển đơn thường 200K+</div>
                <span class="separator">|</span>
                <div class="free-instant-ship-message">⚡ Hỏa tốc nội thành Hà Nội</div>
            </div>
        </a>

        <h1 id="page-title" class="sr-only">@h1Title</h1>

        <div id="empty-result">
            <p>Kết quả trống</p>
        </div>
        <div id="search-result">
            <!-- ✅ HTML5 <template> - cho Load More (JS render) -->
            <template id="product-card-template">
                <article>
                    <a class="product-item" href="#">
                        <div class="image-wrapper">
                            <img class="card-img-top" alt="Card image" width="320" height="480">
                        </div>
                        <div class="product-infor">
                            <div class="product-name">
                                <h3 class="product-name-h3"></h3>
                            </div>
                            <div class="price-sell-original-discount-percent">
                                <span class="price-sell-detail">
                                </span>
                                <span class="price-original-detail"></span>
                                <span class="price-discount-percent-detail"></span>
                            </div>
                        </div>
                    </a>
                </article>
            </template>

            <!-- ✅ SSR: Server render HTML sẵn -->
            <div id="biggestContainer_body_wraper_item">
                @{
                    var productIndex = 0;  // Track index for lazy loading
                }
                @foreach (var product in initialProducts)
                {
                    var (imgWidth, imgHeight) = Common.Get320Dimensions(product.CoverImageWidth, product.CoverImageHeight);

                    <article>
                        <a class="product-item" href="/San-Pham/@(Common.GenerateSlugId(product.Name, product.Id))">
                            <div class="image-wrapper">
                                @* ✅ 10 sản phẩm đầu KHÔNG lazy (above fold desktop/mobile), còn lại lazy + async decode *@
                                <img class="card-img-top"
                                     src="@Common.GenerateV320RelativeSanPhamMediaUrl(product.CoverImageFileName, product.Id)"
                                     alt="@(product.CoverImageAltText ?? ("Bìa sách " + product.Name))"
                                     title="@(product.CoverImageTitle ?? product.Name)"
                                     width="@imgWidth"
                                     height="@imgHeight"@(productIndex >= 10 ? " loading=\"lazy\" decoding=\"async\"" : "")>
                            </div>
                            <div class="product-infor">
                                <div class="product-name">
                                    <h3 class="product-name-h3">@product.Name</h3>
                                </div>
                                <div class="price-sell-original-discount-percent">
                                    <span class="price-sell-detail">@Common.ConvertMoneyToTextWithIcon(product.SalePrice)</span>
                                    @if (product.BookCoverPrice > product.SalePrice)
                                    {
                                        <span class="price-original-detail">@Common.ConvertMoneyToTextWithIcon(product.BookCoverPrice)</span>
                                        <span class="price-discount-percent-detail">-@Common.CalculateDiscountPercent(product.BookCoverPrice, product.SalePrice)%</span>
                                    }
                                </div>
                            </div>
                        </a>
                    </article>
                    productIndex++;
                }
            </div>

            @* Load More section - thay thế numbered pagination *@
            <div id="load-more-section">
                <button id="btnLoadMore" class="pwm-btn-common">
                    <span id="btn-text">Xem thêm sản phẩm</span>
                </button>
                <p id="end-message">
                    🎉 Đã xem hết tất cả sản phẩm
                </p>
            </div>
        </div>

        @Html.Partial("~/Views/Shared/biggestContainer_Bottom.cshtml")
    </div>

    <!-- ✅ SSR: Chỉ pass metadata (HTML đã render sẵn, không cần pass products) -->
    <script>
        window.serverData = {
            hasMore: @hasMore.ToString().ToLower(),
            currentPage: @currentPage,
            lastId: @(initialProducts.Count > 0 ? initialProducts[initialProducts.Count - 1].Id : 0),
            loadedCount: @initialProducts.Count
        };
    </script>

    @* ✅ Bundled JS: Minified + Combined + Auto-versioned *@
    <script defer src="@Scripts.Url("~/bundles/js/common")"></script>
    <script defer src="@Scripts.Url("~/bundles/js/search")"></script>
</body>
</html>
