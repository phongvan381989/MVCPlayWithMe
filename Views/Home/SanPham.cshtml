@using MVCPlayWithMe.Models.SanPhamModel
@using MVCPlayWithMe.General
@{
    Layout = null;
    var sanPham = ViewBag.SanPham as SanPham;
    var variants = ViewBag.Variants as List<SanPham>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>@ViewData["title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0">
    @if (!Context.IsDebuggingEnabled)
    {
        @Html.Partial("~/Views/Shared/_GoogleAnalytics.cshtml")
        @Html.Partial("~/Views/Shared/_MetaPixel.cshtml")
    }

    <!-- SEO Meta Tags -->
    <meta name="description" content="@ViewBag.MetaDescription">
    <link rel="canonical" href="@ViewBag.CanonicalUrl">

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:type" content="product">
    <meta property="og:title" content="@ViewBag.Title">
    <meta property="og:description" content="@ViewBag.MetaDescription">
    <meta property="og:image" content="@ViewBag.OgImageUrl">
    <meta property="og:image:width" content="@ViewBag.OgImageWidth">
    <meta property="og:image:height" content="@ViewBag.OgImageHeight">
    <meta property="og:image:alt" content="@ViewBag.Title">
    <meta property="og:url" content="@ViewBag.CanonicalUrl">
    <meta property="og:site_name" content="@ViewBag.titleVoiBeNho">
    <meta property="og:locale" content="vi_VN">
    <meta property="article:publisher" content="https://www.facebook.com/voibenho">
    <meta property="fb:pages" content="@Common.idFacebookPageTiemSachVBN" />

    <!-- Facebook Product (cho Facebook Shop/Catalog) -->
    <meta property="product:price:amount" content="@sanPham.SalePrice">
    <meta property="product:price:currency" content="VND">
    <meta property="product:availability" content="@(sanPham.Quantity > 0 ? "in stock" : "out of stock")">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@ViewBag.Title">
    <meta name="twitter:description" content="@ViewBag.MetaDescription">
    <meta name="twitter:image" content="@ViewBag.OgImageUrl">

    <link rel="icon" type="image/x-icon" href="~/Media/favico_centered_elephent.png">
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/web.play.with.me.common.css?v=20260610">
    <script defer src="~/Scripts/bootstrap.bundle.min.js"></script>

    <!-- Product Schema.org JSON-LD (Generated from server) -->
    <script type="application/ld+json">@Html.Raw(ViewBag.ProductJsonLD)</script>

    <link rel="stylesheet" href="~/Content/web.play.with.me.modal.common.css?v=20260701">
    <link rel="stylesheet" href="~/Content/Home/SanPham.css?v=20260710d">

    <!-- PhotoSwipe CSS (local v5.3.8) -->
    <link rel="stylesheet" href="~/Content/photoswipe.css?v=538">
</head>
<body>
    <div id="biggestContainer">
        <div id="result-find-id">
            @Html.Partial("~/Views/Shared/biggestContainer_Top.cshtml")
            <div id="item-media-wrapper">
                <div id="item_media_arrow_wrapper">
                    <div id="item-medium-media" title="Giữ kéo chuột để xem ảnh khác">
                        @{
                            // SSR hero image cho SEO (chỉ images - video sẽ embed iframe trong description)
                            var firstMedia = sanPham.MediaList?.FirstOrDefault(m => m.MediaType == "image");
                            string heroSrc = "/Media/NoImageThumbnail.png";
                            string heroAlt = "No Image";
                            int heroWidth = 1000;
                            int heroHeight = 1000;

                            if (firstMedia != null)
                            {
                                heroSrc = $"{MVCPlayWithMe.General.Common.SanPhamMediaFolderPath}{sanPham.Id}/{firstMedia.FileName}";
                                heroAlt = ViewBag.ogImageAlt;
                                heroWidth = (int)(firstMedia.Width > 0 ? firstMedia.Width : 1000);
                                heroHeight = (int)(firstMedia.Height > 0 ? firstMedia.Height : 1000);
                            }
                        }
                        @* SSR hero image - video embeds (YouTube/Facebook/TikTok) sẽ trong description *@
                        <img id="medium_picture"
                             src="@heroSrc"
                             alt="@heroAlt"
                             width="@heroWidth"
                             height="@heroHeight">
                    </div>
                    <div id="left_arrow" title="Ảnh trước"></div>
                    <div id="right_arrow" title="Ảnh sau"></div>
                </div>
                <div id="item-small-media-container">
                    @* SSR thumbnail gallery cho initial load (chỉ images) - JavaScript re-render khi switch variant *@
                    @Html.Raw(ViewBag.ThumbnailGalleryHtml)
                </div>
            </div>
            <div id="item-something-wrapper">
                <div id="item-name" style="width:100%">
                    <h1 id="item-name-h1">@sanPham.Name</h1>
                </div>
                <div id="item-vote">

                </div>
                <div id="item-price">
                    @{
                        var salePrice = sanPham.SalePrice;
                        var bookCoverPrice = sanPham.BookCoverPrice;
                        // Tính discount runtime (match JavaScript logic)
                        var discountPercent = bookCoverPrice > 0
                            ? (int)Math.Round(100.0 * (bookCoverPrice - salePrice) / bookCoverPrice)
                            : 0;
                    }
                    <div id="price"><sup>₫</sup>@salePrice.ToString("N0")</div>
                    @if (bookCoverPrice > salePrice)
                    {
                        <div id="book-cover-price"><del><sup>₫</sup>@bookCoverPrice.ToString("N0")</del></div>
                        <div id="discount">@discountPercent% giảm</div>
                    }
                </div>
                <div class="_7VDqtl">
                    <div id="item-variation-container">@Html.Raw(ViewBag.VariationsHtml)
                    </div>

                    <div id="item-order">
                        <div class="flex-items-center">
                            <div style="margin-right: 15px;">
                                <div class="shopee-input-quantity">
                                    <button type="button" class="xNxl-t" onclick="Decrease()">
                                        <svg xmlns="http://www.w3.org/2000/svg" xmlns: xlink="http://www.w3.org/1999/xlink" version="1.1" viewBox="0 0 10 10" x="0" y="0" class="shopee-svg-icon"><polygon points="4.5 4.5 3.5 4.5 0 4.5 0 5.5 3.5 5.5 4.5 5.5 10 5.5 10 4.5"></polygon></svg>
                                    </button>
                                    <input class="VWjjde" type="text" value="1" id="quantity-input"
                                           oninput="ValidateInput(event)">
                                    <button type="button" class="xNxl-t" onclick="Increase()">
                                        <svg xmlns="http://www.w3.org/2000/svg" xmlns: xlink="http://www.w3.org/1999/xlink" version="1.1" viewBox="0 0 10 10" x="0" y="0" class="shopee-svg-icon"><polygon points="10 4.5 5.5 4.5 5.5 0 4.5 0 4.5 4.5 0 4.5 0 5.5 4.5 5.5 4.5 10 5.5 10 5.5 5.5 10 5.5"></polygon></svg>
                                    </button>
                                </div>
                            </div>
                            <div id="max-quatity">@sanPham.Quantity sản phẩm có sẵn</div>
                        </div>
                    </div>

                    <div class="I-H1Co"></div>
                </div>
                <div class="p-UZsF">
                    <button type="button" class="btn-add-to-cart" onclick="AddToCart()">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns: xlink="http://www.w3.org/1999/xlink" version="1.1"
                             viewBox="0 0 15 15" x="0" y="0" class="icon-add-to-cart">
                            <g>
                                <g>
                                    <polyline fill="none" points=".5 .5 2.7 .5 5.2 11 12.4 11 14.5 3.5 3.7 3.5" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10">
                                    </polyline>
                                    <circle cx="6" cy="13.5" r="1" stroke="none">
                                    </circle>
                                    <circle cx="11.5" cy="13.5" r="1" stroke="none">
                                    </circle>
                                </g>
                                <line fill="none" stroke-linecap="round" stroke-miterlimit="10" x1="7.5" x2="10.5" y1="7" y2="7">
                                </line>
                                <line fill="none" stroke-linecap="round" stroke-miterlimit="10" x1="9" x2="9" y1="8.5" y2="5.5">
                                </line>
                            </g>
                        </svg>
                        <span>Thêm Vào Giỏ Hàng</span>
                    </button>
                    <button type="button" class="btn-buy-now" onclick="GoToCartNow()">
                        Mua ngay
                    </button>
                </div>
            </div>
            <div class="product-specifications">
                <section class="U9rGd1">
                    <h2 class="Iv7FJp">THÔNG TIN CHI TIẾT</h2>
                    <div class="specifications-table">@Html.Raw(ViewBag.SpecificationsHtml)
                    </div>
                </section>
            </div>
            <div class="product-detail">
                <section class="U9rGd1">
                    <h2 class="Iv7FJp">MÔ TẢ SẢN PHẨM</h2>
                    <div class="MCCLkq">
                        <div class="f7AU53">@Html.Raw(ViewBag.DescriptionHtml)
                        </div>
                    </div>
                </section>
            </div>
            <div class="other-product">

            </div>

            @Html.Partial("~/Views/Shared/Home/SelectedModal.cshtml")
        </div>

        @Html.Partial("~/Views/Shared/DoesntFindId.cshtml")
        @Html.Partial("~/Views/Shared/biggestContainer_Bottom.cshtml")
    </div>

    <!-- Pass server data vào JavaScript -->
    <script>
        // Data từ server (SSR) - JavaScript dùng cho tương tác, KHÔNG fetch API
        window.serverData = {
            variants: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(variants)),
            currentId: @sanPham.Id
        };
    </script>

    <script src="~/Scripts/web.play.with.me.common.js?v=20260916"></script>
    <script src="~/Scripts/cart-manager.js"></script>
    <script src="~/Scripts/web.play.with.me.action.common.js?v=20260701"></script>
    <!-- PhotoSwipe JS (local v5.3.8) -->
    <script src="~/Scripts/photoswipe.umd.min.js?v=538"></script>
    <script src="~/Scripts/photoswipe-lightbox.umd.min.js?v=538"></script>

    <script src="~/Scripts/Home/SanPham.js?v=20260916"></script>
</body>
</html>
