@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.table.show.data.css?v=20260610">
    <link rel="stylesheet" href="~/Content/web.play.with.me.modal.common.css" />
    <link rel="stylesheet" href="~/Content/Order/OrderManually.css?v=20260610">
</head>
<body>
    <div id="biggestContainer">
        <div class="config-max-width padding-container">
            <div style="margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 5px; background-color: #f9f9f9;">
                <h4 style="margin-top: 0;">Thông Tin Người Nhận</h4>

                <div style="margin-bottom: 10px;">
                    <button type="button" onclick="ShowCustomerInforModal(true, false, null)" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
                        Nhập Thông Tin Người Nhận
                    </button>
                </div>

                <!-- Hiển thị thông tin đã nhập -->
                <div id="customer-infor-display" style="display: none; padding: 10px; background-color: #e8f4f8; border-radius: 4px; margin-bottom: 10px;">
                    <div style="margin-bottom: 5px;"><strong>Họ tên:</strong> <span id="display-name"></span></div>
                    <div style="margin-bottom: 5px;"><strong>SĐT:</strong> <span id="display-phone"></span></div>
                    <div style="margin-bottom: 5px;"><strong>Địa chỉ:</strong> <span id="display-address"></span></div>
                    <button type="button" onclick="ShowCustomerInforModal(false, false, currentCustomerInfor)" style="padding: 5px 15px; margin-top: 5px;">Sửa</button>
                </div>

                <div style="margin-bottom: 10px;">
                    <label for="customer-message">Tin nhắn:</label>
                    <textarea class="config-max-width margin-vertical" id="customer-message" rows="3" placeholder="Tin nhắn của người đặt đơn"></textarea>
                </div>

                <div style="margin-bottom: 10px;">
                    <label for="shipping-fee">Phí ship:</label>
                    <input type="number" class="config-max-width margin-vertical" id="shipping-fee" placeholder="Nhập phí ship" value="0" min="0" step="1000">
                </div>

                <div style="margin-bottom: 10px;">
                    <label for="order-from">Nguồn đơn hàng:</label>
                    <select class="config-max-width margin-vertical" id="order-from">
                        <option value="0">Web (voibenho.com)</option>
                        <option value="1" selected>Facebook</option>
                        <option value="3">Zalo</option>
                    </select>
                </div>

                <div style="margin-bottom: 10px;">
                    <label for="order-pay-status">Trạng thái thanh toán:</label>
                    <select class="config-max-width margin-vertical" id="order-pay-status">
                        <option value="0" selected>ĐANG CHỜ XỬ LÝ</option>
                        <option value="1">ĐÃ THANH TOÁN</option>
                        <option value="2">ĐÃ HOÀN TIỀN</option>
                    </select>
                </div>

                <div style="margin-bottom: 10px;">
                    <label for="payment-method">Phương thức thanh toán:</label>
                    <select class="config-max-width margin-vertical" id="payment-method">
                        <option value="0">Tiền mặt</option>
                        <option value="1" selected>Chuyển vào tk hộ kinh doanh</option>
                    </select>
                </div>
            </div>

            <div>
                <label for="publisher-id">Nhà phát hành:</label>
                <input list="list-Publisher" class="config-max-width margin-vertical"
                       id="publisher-id" onchange="GetBasicInfoProduct()">
                <datalist id="list-Publisher"></datalist>
            </div>
            <br>

            <label for="code-or-isbn">Mã sản phẩm hoặc ISBN:</label><br>
            <input class="config-max-width margin-vertical" type="text" id="code-or-isbn" value="">
            <br>
            @Html.Partial("~/Views/Shared/ProductNameSelect.cshtml")
            <br />
            <div>
                <label for="combo-id">Combo:</label>
                <input list="list-combo" class="config-max-width margin-vertical" id="combo-id">

                <datalist id="list-combo"></datalist>
            </div>
            <br />

            <div style="margin-bottom: 10px;">
                <label for="discount-input">Chiết khấu (%):</label>
                <input type="number" class="config-max-width margin-vertical" id="discount-input" value="0" min="0" max="100" step="0.01">
            </div>

            <div style="margin-bottom: 10px;">
                <label for="quantity-input">Số lượng:</label>
                <input type="number" class="config-max-width margin-vertical" id="quantity-input" value="1" min="1" step="1">
            </div>

            <div class="config-max-width sfxvsg90svx">
                <button type="button" onclick="AddHeadList()" class="akfhz95nzk"
                        title="Thêm sản phẩm vào danh sách nhập kho bên dưới" id="add-head-list">
                    Thêm vào danh sách
                </button>
            </div>
            <br />
            <br />
            <table id="myTable">
                <tr>
                    <th style="display:none"></th>
                    <th style="width:200px">Ảnh</th>
                    <th>Tên</th>
                    <th>Giá Bìa</th>
                    <th>Chiết Khấu</th>
                    <th>Giá Bán</th>
                    <th>Số Lượng</th>
                    <th>Tổng Tiền</th>
                    <th>Tồn kho</th>
                    <th></th>
                </tr>
            </table>

            <div style="margin-top: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 5px; background-color: #f0f8ff; max-width: 400px; margin-left: auto;">
                <h4 style="margin-top: 0; margin-bottom: 15px;">Tổng Kết Đơn Hàng</h4>

                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span>Tổng tiền sản phẩm:</span>
                    <span id="total-products" style="font-weight: bold;">0 ₫</span>
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span>Phí ship:</span>
                    <span id="total-shipping" style="font-weight: bold; color: #ff6600;">0 ₫</span>
                </div>

                <hr style="border: 1px solid #ddd;">

                <div style="display: flex; justify-content: space-between; margin-top: 10px;">
                    <span style="font-size: 18px; font-weight: bold;">Tổng Thanh Toán:</span>
                    <span id="total-payment" style="font-size: 20px; font-weight: bold; color: #007bff;">0 ₫</span>
                </div>
            </div>

            <div class="config-max-width">
                <br />
                <button type="button" onclick="CreateOrderManually()">Tạo đơn hàng thủ công</button>
                <button type="button" style="float: right;" onclick="Delete()">Xóa toàn bộ</button>
            </div>
        </div>
    </div>

    @Html.Partial("~/Views/Shared/Home/CustomerInfor.cshtml")

    <script src="~/Scripts/web.play.with.me.common.js?v=20260916"></script>
    <script src="~/Scripts/web.play.with.me.customer.infor.cookie.js"></script>
    <script src="~/Scripts/web.play.with.me.address.js?v=20260916"></script>
    <script src="~/Scripts/Order/OrderManually.js?v=20260610"></script>
</body>
</html>
