@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/web.play.with.me.table.show.data.css?v=20260610">
    <link rel="stylesheet" href="~/Content/web.play.with.me.modal.common.css?v=20260610">
    <link rel="stylesheet" href="~/Content/ProductECommerce/Item.css?v=20260610">
</head>
<body>
    <div id="biggestContainer">
        <div class="config-max-width padding-container" id="result-find-id">
            <div class="one-item-container">
                <a id="anzka89zbhfj" target="_blank" href=""
                   title="Click để đi trang xem sản phẩm trên sàn.">
                    <img class="item-image-ACvv">
                </a>
                <div class="fcpaxm09zf">
                    <div id="item-status-azc"></div>
                    <div id="item-name-vsfc"></div>
                </div>
            </div>
            <div id="model-list">
            </div>

            <div>
                <!-- The Modal -->
                <div id="myModal" class="modal">
                    <!-- Modal content -->
                    <div class="modal-content">
                        <div>
                            <span class="close">&times;</span>
                        </div>
                        <div>
                            <label for="code-or-isbn">Mã sản phẩm hoặc ISBN:</label><br>
                            <input class="config-max-width margin-vertical" type="text" id="code-or-isbn" value="">
                            <br>

                            @Html.Partial("~/Views/Shared/ProductNameSelect.cshtml")

                            @Html.Partial("~/Views/Shared/ComboSelect.cshtml")

                            @Html.Partial("~/Views/Shared/RowsDistance.cshtml")
                            <button type="button" onclick="SearchProductForMapping()">Tìm kiếm</button>
                            @Html.Partial("~/Views/Shared/RowsDistance.cshtml")
                        </div>

                        <p> Bảng kết quả tìm kiếm:</p>
                        <div>
                            <table id="myTable" onchange="OnChangeMyTable()">
                                <tr>
                                    <th style="display:none"></th>
                                    <th style="width:30px" title="Chọn/Bỏ Chọn Tất Cả">
                                        <div>
                                            <input type="checkbox" id="select-all-result-search" style="margin-right: 5px;"
                                                   onclick="ClickSelectAllResultSearch()">
                                            <label for="select-all-result-search">Chọn</label>
                                        </div>
                                    </th>
                                    <th style="width:200px">Ảnh</th>
                                    <th>Tên</th>
                                </tr>
                            </table>
                        </div>

                        @Html.Partial("~/Views/Shared/RowsDistance.cshtml")
                        <p> Bảng liên kết sản phẩm:</p>
                        <div>
                            <table id="myTableMapping">
                                <tr>
                                    <th style="display:none"></th>
                                    <th style="width:200px">Ảnh</th>
                                    <th>Tên</th>
                                    <th>Số lượng</th>
                                    <th style="width:30px"></th>
                                </tr>
                            </table>
                        </div>
                        @Html.Partial("~/Views/Shared/RowsDistance.cshtml")
                        <div>
                            <button type="button" onclick="SaveMappingToModel()">Lưu liên kết</button>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" id="update-eEcommerce-mapping" onclick="UpdateEEcommerceMapping()"
                    title="Cập nhật tất cả liên kết">
                Cập nhật tất cả liên kết
            </button>

            <button type="button" id="update-price-sale-price" onclick="UpdateQuantityPrice_SpecialPrice()"
                    title="Cập nhật tồn kho, giá bìa, giá bán đối với sản phẩm sàn Lazada">
                Cập nhật tồn kho, giá bán, giá bìa
            </button>
        </div>
        @Html.Partial("~/Views/Shared/DoesntFindId.cshtml")
    </div>

    <script src="~/Scripts/web.play.with.me.common.js?v=20260610"></script>
    <script src="~/Scripts/ProductECommerce/item.js?v=20260610"></script>
</body>
</html>

