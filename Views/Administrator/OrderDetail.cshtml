@{
    Layout = null;
    int? orderId = ViewData["orderId"] as int?;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    @Html.Partial("~/Views/Shared/Head.cshtml")
    <link rel="stylesheet" href="~/Content/Administrator/OrderDetail.css?v=20260809">
</head>
<body>
    <div id="biggestContainer">
        <div class="admin-order-detail-container">

            <h1 class="page-title">Chi tiết đơn hàng</h1>

            <!-- Sample templates (hidden, dùng để clone) -->
            <div class="sample-item-container">
                <img class="model-icon"
                     src="/Media/NoImageThumbnail.png"
                     onerror="this.onerror=null; this.src='/Media/NoImageThumbnail.png';"
                     alt="No image"
                     loading="lazy" />
                <div class="name-quantity">
                    <div class="ffZM87hf-name">Tên sản phẩm</div>
                    <div class="G7E4B7">
                        <span class="vWt6ZL">₫39.000</span>
                        <span class="M-AAFK">₫29.800</span>
                        <span class="quantity-model-x">x</span>
                        <span class="quantity-model">1</span>
                    </div>
                </div>
            </div>

            <div class="sample-order">
                <div class="order-header">
                    <div class="order-code"></div>
                    <span class="yMGIuJ">|</span>
                    <div class="fxASnxvd"></div>
                </div>
                <div class="sample-address-container">
                    <div class="address-date"></div>
                    <div class="address-name-phone"></div>
                    <div class="address-address"></div>
                </div>
                <div class="order-item-container">

                </div>
                <div class="message-to-shop">
                    <div class="gQuJxM">Lời nhắn</div>
                </div>
                <div class="payment-method">
                    <div class="SzEjHI">Phương thức thanh toán</div>
                    <div class="mvna89xnd">
                        <div class="hjhgui88">
                            <span class="KoRB7y payment-method-text">Thanh toán khi nhận hàng</span>
                        </div>
                    </div>
                </div>
                <div class="payment-infor">
                    <div class="checkout-money-flex-end ">
                        <div class="money-title">Tổng tiền hàng</div>
                        <div class="money-padding model-money-sum"></div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Phí vận chuyển</div>
                        <div class="money-padding shipee-fee"></div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Giảm giá phí vận chuyển</div>
                        <div class="money-padding free-shipee-fee"></div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Giảm giá tổng tiền hàng</div>
                        <div class="money-padding discount-final-money"></div>
                    </div>
                    <div class="checkout-money-flex-end">
                        <div class="money-title">Tổng thanh toán</div>
                        <div class="money-padding final-money"></div>
                    </div>
                </div>
            </div>

            <!-- Result container -->
            <div class="result-container">
                <div class="result-content-container">
                    <div class="empty-order-state">Đang tải...</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Pass orderId từ server sang client
        var ORDER_ID = @(orderId.HasValue ? orderId.Value.ToString() : "null");
    </script>

    <script src="~/Scripts/web.play.with.me.common.js?v=20260809"></script>
    <script src="~/Scripts/Customer/CommonOrder.js?v=20260809"></script>
    <script src="~/Scripts/Administrator/OrderDetail.js?v=20260809"></script>
</body>
</html>
